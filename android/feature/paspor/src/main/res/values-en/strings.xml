    <!-- 6.5 Location denied (Android app settings instead of the browser) -->
    <string name="paspor_ditolak_title">Stamps need your location permission</string>
    <string name="paspor_ditolak_body">You declined location permission earlier. Turn it back on in the app settings:</string>
    <string name="paspor_ditolak_step1"><![CDATA[Tap <b>Open app settings</b> below.]]></string>
    <string name="paspor_ditolak_step2"><![CDATA[Choose <b>Permissions</b>, then <b>Location</b>.]]></string>
    <string name="paspor_ditolak_step3"><![CDATA[Choose <b>Allow only while using the app</b> and turn on <b>Use precise location</b>, then come back here.]]></string>
    <string name="paspor_open_settings">Open app settings</string>

