<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      No CAMERA permission: the photo comes from the system camera app (TakePicture) or the Photo Picker.
      No storage permission: saving uses MediaStore on API 29+.
    -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.whatsapp" />
    </queries>

    <application>
        <provider
            android:name="id.kelana.feature.postcard.data.PostcardFileProvider"
            android:authorities="${applicationId}.postcard.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/postcard_file_paths" />
        </provider>
    </application>
</manifest>
