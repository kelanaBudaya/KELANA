# Copy to .env.local and fill in. Never commit .env.local.
# Project URL and the anon (publishable) key from Supabase > Project Settings > API.
# The admin panel signs in as the staff member and relies on RLS; it never uses the service role key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
